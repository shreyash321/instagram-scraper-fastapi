# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Instagram Authentication (Optional, but recommended for high volume scraping & avoiding 401s)
# How to get: Open instagram.com in Chrome -> F12 DevTools -> Application -> Cookies -> Copy value of 'sessionid'
INSTAGRAM_SESSION_ID=

# Default Scraping Limits
DEFAULT_MAX_POSTS=10
DEFAULT_MAX_COMMENTS=5
